VITE_API_URL=http://localhost:3000

# Amostra online (build de vitrine no Render):
# VITE_AMOSTRA_ONLINE=true ativa credencial única + queima de 4h.
# Defina VITE_DEMO_SENHA no dashboard do Render (nunca commite a senha real).
VITE_AMOSTRA_ONLINE=false
VITE_DEMO_USUARIO=demo
VITE_DEMO_SENHA=troque-antes-do-deploy
# Autodestruição do site: timestamp ISO após o qual o app nem monta.
# No Render, deixe vazio e o buildCommand calcula deploy + 14h; para forçar
# um horário, defina ex.: 2026-09-24T12:00:00.000Z
VITE_AMOSTRA_EXPIRA_EM=
